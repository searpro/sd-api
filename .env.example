# Path to the stable-diffusion.cpp CLI binary. If it is missing and
# SD_AUTO_INSTALL is enabled, a matching prebuilt release is downloaded.
SD_BINARY_PATH=sd

# Auto-install a prebuilt stable-diffusion.cpp release on startup if the
# binary above is not found.
SD_AUTO_INSTALL=true
# Where downloaded binaries are unpacked.
SD_INSTALL_DIR=./data/bin
# Release tag to install: "latest" or a specific tag (e.g. master-714-b12098f).
SD_RELEASE_TAG=latest
# Hardware backend to prefer when picking a release asset: cpu | vulkan | cuda | rocm
SD_ACCEL=cpu

# Root directory that holds models/, vae/, clip/ subdirectories.
SD_MODELS_DIR=./data/models

# Where generated images are written.
SD_OUTPUTS_DIR=./data/outputs

# HTTP server.
SD_HOST=0.0.0.0
SD_PORT=3000

# Job execution.
SD_MAX_CONCURRENT_JOBS=2
# Hard timeout for a single generation process, in milliseconds.
SD_JOB_TIMEOUT_MS=600000

# Safety limits.
SD_MAX_IMAGE_DIM=2048

# Log level: trace | debug | info | warn | error | fatal
SD_LOG_LEVEL=info
