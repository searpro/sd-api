# Path to the compiled stable-diffusion.cpp CLI binary (the `sd` executable).
SD_BINARY_PATH=/usr/local/bin/sd

# Root directory that holds models/, vae/, clip/ subdirectories.
SD_MODELS_DIR=./data/models

# Where generated images are written.
SD_OUTPUTS_DIR=./data/outputs

# HTTP server.
SD_HOST=0.0.0.0
SD_PORT=3000

# Job execution.
SD_MAX_CONCURRENT_JOBS=2
# Hard timeout for a single generation process, in milliseconds.
SD_JOB_TIMEOUT_MS=600000

# Safety limits.
SD_MAX_IMAGE_DIM=2048

# Log level: trace | debug | info | warn | error | fatal
SD_LOG_LEVEL=info
