# Path to the stable-diffusion.cpp CLI binary. If it is missing and
# SD_AUTO_INSTALL is enabled, a matching prebuilt release is downloaded.
SD_BINARY_PATH=sd

# Auto-install a prebuilt stable-diffusion.cpp release on startup if the
# binary above is not found.
SD_AUTO_INSTALL=true
# Where downloaded binaries are unpacked.
SD_INSTALL_DIR=./data/bin
# "owner/repo" to query for stable-diffusion.cpp releases. Defaults to
# upstream, which does not publish a Linux CUDA build and whose dynamic
# Vulkan backend has a known ABI-mismatch bug (undefined symbol:
# ggml_backend_score) — override with a fork/mirror that publishes a working
# build for your platform/accel.
SD_RELEASES_REPO=leejet/stable-diffusion.cpp
# Release tag to install: "latest" or a specific tag (e.g. master-714-b12098f).
SD_RELEASE_TAG=latest
# Hardware backend to prefer when picking a release asset: cpu | vulkan | cuda | rocm
SD_ACCEL=cpu

# HuggingFace access token. Required to download GATED or PRIVATE models, and
# raises the Hub API rate limit used by the model catalog. Create one at
# https://huggingface.co/settings/tokens (read scope is enough), and accept each
# gated model's license on its model page. Also honored: HUGGING_FACE_HUB_TOKEN.
# Check status at GET /v1/auth/hf and POST /v1/auth/hf/verify (or the Catalog tab).
# HF_TOKEN=

# Root directory holding per-model bundle directories (each with its own
# checkpoint/, vae/, clip/ sub-folders).
SD_MODELS_DIR=./data/models

# Where generated images are written.
SD_OUTPUTS_DIR=./data/outputs

# Where uploaded input images (for img2img / edit) are stored.
SD_INPUTS_DIR=./data/inputs

# HTTP server.
SD_HOST=0.0.0.0
SD_PORT=3000

# Job execution. This is the hard cap on how many stable-diffusion.cpp
# processes run at once, across BOTH POST /v1/generate and the /v1/jobs queue.
# Each process loads the full model into memory, so raising this multiplies
# peak RAM by roughly the model size — on most machines 2 concurrent loads of
# a multi-gigabyte bundle exhausts memory and the OS kills the server. Raise
# it only if you know the headroom is there.
SD_MAX_CONCURRENT_JOBS=1
# Max concurrent model-component downloads.
SD_MAX_CONCURRENT_DOWNLOADS=2
# Hard timeout for a single generation process, in milliseconds.
SD_JOB_TIMEOUT_MS=600000
# Hard timeout for video (mode:"video", e.g. Wan) generations — much longer-running than images.
SD_VIDEO_JOB_TIMEOUT_MS=3600000

# Safety limits.
SD_MAX_IMAGE_DIM=2048

# Log level: trace | debug | info | warn | error | fatal
SD_LOG_LEVEL=info

# --- LLM serving (llama.cpp) ---------------------------------------------

# Path to the llama-server binary. If it is missing and SD_LLM_AUTO_INSTALL
# is enabled, a matching prebuilt llama.cpp release is downloaded.
SD_LLM_BINARY_PATH=llama-server

# Auto-install a prebuilt llama.cpp release on startup if the binary above is
# not found.
SD_LLM_AUTO_INSTALL=true
# Where downloaded binaries are unpacked.
SD_LLM_INSTALL_DIR=./data/llm-bin
# Release tag to install: "latest" or a specific tag.
SD_LLM_RELEASE_TAG=latest
# Hardware backend to prefer when picking a release asset: cpu | vulkan | cuda | rocm
SD_LLM_ACCEL=cpu

# Root directory scanned by `llama-server --models-dir` (router mode). Each
# subdirectory's name is the model id an OpenAI client passes as "model".
SD_LLM_MODELS_DIR=./data/llm-models

# Internal port llama-server listens on (127.0.0.1 only — never exposed
# directly; sd-api reverse-proxies /v1/llm/* to it).
SD_LLM_PORT=8090
# Context size (-c).
SD_LLM_CTX_SIZE=4096
# GPU layers (-ngl); -1 omits the flag and lets llama-server auto-decide.
SD_LLM_GPU_LAYERS=-1
# Enable chat-template / tool-calling support (--jinja).
SD_LLM_JINJA=true
# How long to wait for llama-server's /health before giving up, in milliseconds.
SD_LLM_STARTUP_TIMEOUT_MS=30000

HF_TOKEN=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 #Lijin Kurian
